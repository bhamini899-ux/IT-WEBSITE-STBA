rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isValidId(attendanceId);
    }

    match /homework/{homeworkId} {
      allow read: if true;
      allow write: if isValidId(homeworkId);
    }

    match /circulars/{circularId} {
      allow read: if true;
      allow write: if isValidId(circularId);
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isValidId(examId);
    }

    match /timetable/{slotId} {
      allow read: if true;
      allow write: if isValidId(slotId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
